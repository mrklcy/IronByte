NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://trainhack:trainhack@localhost:5432/trainhack?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-32-byte-access-secret
JWT_REFRESH_SECRET=replace-with-32-byte-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
COOKIE_SECURE=false
LOG_LEVEL=info
